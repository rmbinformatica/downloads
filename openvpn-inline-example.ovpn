dev tun
persist-tun
persist-key
route-delay 5
up-delay
#cipher AES-256-CBC
data-ciphers-fallback 'AES-256-CBC'
auth SHA1
tls-client
client
resolv-retry infinite
remote vpn-server.example.com 1194 udp
lport 0
<ca>
</ca>
<key>
</key>
<cert>   
</cert>
key-direction 1
<tls-auth>
</tls-auth>
remote-cert-tls server
;comp-lzo
;redirect-gateway def1
#dhcp-option DNS 8.8.8.8
#dhcp-option DNS 1.1.1.1
#dhcp-option DNS 192.168.147.1